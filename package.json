{
  "name": "@adddog/monorepo-consistency",
  "version": "0.2.0",
  "type": "module",
  "bin": {
    "mono": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "types": "tsgo -p tsconfig.typecheck.json",
    "dev": "tsx src/cli.ts",
    "release": "bumpp --yes --no-push --no-tag --release patch",
    "generate-schema": "tsx scripts/generate-schema.ts",
    "prepack": "pnpm run build",
    "build:watch": "tsup --watch",
    "test": "vitest --watch=false",
    "knip": "knip",
    "version:patch": "npm version patch --no-git-tag-version"
  },
  "dependencies": {
    "@adddog/zod-to-json-schema": "workspace:*",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "dpdm": "^4.3.0",
    "fast-glob": "^3.3.3",
    "lodash": "^4.18.1",
    "madge": "^8.0.0",
    "minimatch": "^10.2.6",
    "ora": "^9.4.1",
    "taze": "^21.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5",
    "zx": "^8.8.5"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.25",
    "@types/madge": "^5.0.3",
    "@types/node": "^26.6.4",
    "@typescript/native-preview": "beta",
    "@vitest/coverage-v8": "^5.0.3",
    "bumpp": "^12.3.0",
    "eslint": "^10.12.0",
    "knip": "^6.39.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  },
  "bundledDeps": true,
  "peerDependencies": {
    "@vue/compiler-sfc": "^3.5.43"
  },
  "engines": {
    "node": ">= 22",
    "pnpm": ">= 10",
    "npm": ">= 11"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  }
}
